!/dataset/hand_analysis/runs/low_string_stability_20261105_v1/temporal_metrics.png
!/dataset/hand_analysis/runs/low_string_stability_20261105_v1/summary.json

# Never publish private key / credential files
*.pem
*.key
credentials*.json
service-account*.json

/scratch/
scratch_crop.jpg

/bin/

