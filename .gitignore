# Keep research reports and a small, explicitly selected set of diagnostics.
# Raw data, per-frame results and API responses remain excluded.
/dataset/**
!/dataset/**/
!/dataset/**/*.md
!/dataset/regression/*.json
!/dataset/audio_analysis/requirements.txt
!/dataset/integration_review/runs/egdb_timbre_20261105_v1/*.png
!/dataset/integration_review/runs/egdb_timbre_20261105_v1/summary.json
!/dataset/integration_review/runs/egdb_timbre_20261105_v1/availability.json
!/dataset/integration_review/runs/egdb_timbre_20261105_v1/levels.json
!/dataset/integration_review/runs/egdb_timbre_20261105_v1/review.html
